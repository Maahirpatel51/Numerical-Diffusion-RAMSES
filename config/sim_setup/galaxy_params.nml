&RUN_PARAMS 
hydro=.true.
poisson=.true.
pic=.true.
ncontrol=1
nsubcycle=1,1,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2
nremap=20
nrestart=0
verbose=.false.
/

&AMR_PARAMS
levelmin=6
levelmax=18
ngridmax=700000
npartmax=6000000
boxlen=600.0
/

&INIT_PARAMS
filetype='ascii'
initfile(1)='/home/robinh4/agora_ICs/MED'
p_region=1e-6
d_region=1e-6
B_ave=0
/

&OUTPUT_PARAMS
