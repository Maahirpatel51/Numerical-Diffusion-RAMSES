&RUN_PARAMS
hydro=.true.
poisson=.false.
ncontrol=1
/

&AMR_PARAMS
levelmin=8
levelmax=8
ngridtot=40000
ngridmax=200000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
nregion=1
region_type(1)='wave'
x_center(1)=0.5
y_center(1)=0.5
z_center(1)=0.5
exp_region(1)=10.0

d_region(1)=1.0
u_region(1)=128.0
v_region(1)=0.001
w_region(1)=0.5
p_region(1)=0.1
/
 
&OUTPUT_PARAMS
tend=10.0
delta_tout=0.05
/

&HYDRO_PARAMS
gamma=1.6666666666666666
courant_factor=0.4
slope_type=1
riemann='hllc'
/

&POISSON_PARAMS
gravity_type=0
/